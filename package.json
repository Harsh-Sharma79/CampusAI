{
  "name": "campusai-backend-workspace",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": ["server"],
  "scripts": {
    "dev": "npm --workspace @campusai/server run dev",
    "build": "npm --workspace @campusai/server run build",
    "start": "npm --workspace @campusai/server run start",
    "test": "npm --workspace @campusai/server run test",
    "typecheck": "npm --workspace @campusai/server run typecheck",
    "prisma:generate": "npm --workspace @campusai/server run prisma:generate",
    "prisma:validate": "npm --workspace @campusai/server run prisma:validate",
    "migrate:dev": "npm --workspace @campusai/server run migrate:dev",
    "migrate:deploy": "npm --workspace @campusai/server run migrate:deploy"
  }
}
