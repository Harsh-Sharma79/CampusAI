NODE_ENV=development
PORT=5000

# The Manus-managed database is MySQL-compatible. CampusAI's required PostgreSQL/pgvector
# database must be supplied separately with pgvector installed.
CAMPUSAI_POSTGRES_URL=postgresql://campusai:change-me@localhost:5432/campusai?schema=public

# Public Supabase metadata for the already-built frontend. The backend does not use the
# publishable key for database access; it connects with CAMPUSAI_POSTGRES_URL above.
SUPABASE_PROJECT_ID=uniwzstvuxipiomibybj
SUPABASE_URL=https://uniwzstvuxipiomibybj.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_72GtBxz6UCJSuVLZhJCETw_Qms65M4D

# Generate distinct values with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
GEMINI_MAX_INPUT_CHARS=80000
GEMINI_MAX_OUTPUT_TOKENS=4096

CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
MAX_DOCUMENT_CHARS=500000

# Set STORAGE_DRIVER=s3 in production for AWS S3, Cloudflare R2, or Supabase S3-compatible storage.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# SMTP is required for real password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_TTL_MINUTES=30

LOG_LEVEL=info
AI_RATE_LIMIT_PER_MINUTE=20
AUTH_RATE_LIMIT_PER_MINUTE=10
