{
  "name": "@campusai/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "multer": "2.4.0",
    "nodemailer": "10.0.13",
    "pdfjs-dist": "5.4.149",
    "pino": "9.9.0",
    "swagger-ui-express": "5.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "6.4.20",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "prisma": "6.12.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
